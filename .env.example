# 이 파일을 .env 로 복사해 값을 채우세요. .env 는 git 에 올라가지 않습니다. 토큰은 채팅·문서에 붙여넣지 마세요.
META_ACCESS_TOKEN=
# 국가별 광고계정 ID (해당 국가 소재는 그 계정에서만 검색). 필요한 국가만 채우세요.
META_AD_ACCOUNT_ID_MY=
META_AD_ACCOUNT_ID_SG=
META_AD_ACCOUNT_ID_ID=
META_AD_ACCOUNT_ID_PH=
# 국가 구분 없이 쓸 계정 (쉼표로 여러 개 가능). 국가별 칸이 비어 있을 때만 사용됩니다.
META_AD_ACCOUNT_ID=
# 선택: Graph API 버전 (기본 v21.0)
# META_GRAPH_VERSION=v21.0
# 토큰을 발급한 날짜(YYYY-MM-DD). 적어 두면 50일이 지날 때 점검 화면이 갱신을 알려 줍니다.
META_TOKEN_ISSUED=
